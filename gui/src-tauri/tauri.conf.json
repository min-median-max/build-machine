{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Build Machine",
  "version": "0.0.1",
  "identifier": "local.buildmachine.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Build Machine", "width": 1240, "height": 840,
      "minWidth": 1000, "minHeight": 700, "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": { "active": true, "targets": ["app"],
    "externalBin": ["binaries/build-machine-worker"],
    "resources": { "../../workers": "workers/", "../../machine.json": "machine.json" }, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
